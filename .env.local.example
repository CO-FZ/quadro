# Variáveis de ambiente para desenvolvimento local (copie para .env.local).
# .env.local é ignorado pelo git — NUNCA commite valores reais aqui.
#
# Onde obter: Supabase Dashboard → Project Settings → API.

# URL pública do projeto Supabase (vai para o bundle do browser).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable/anon do Supabase (pública por design).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: link da planilha do Google Sheets exibido na /matriz.
# Deixe vazio para esconder o botão "Abrir no Google Sheets".
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# Chave da Google Maps JavaScript API, usada na /mapa (alocação do efetivo em obras).
# É pública por natureza (vai para o bundle do browser) — a segurança vem de restringi-la
# por HTTP referrer no Google Cloud Console, não de mantê-la secreta.
#
# Como provisionar:
#   1. https://console.cloud.google.com/ → crie ou selecione um projeto.
#   2. APIs & Services → Library → habilite "Maps JavaScript API".
#   3. APIs & Services → Credentials → Create Credentials → API key.
#   4. Restrinja a chave: Application restrictions → HTTP referrers → adicione
#      seu domínio de produção e http://localhost:3000/*.
#   5. API restrictions → limite a chave a "Maps JavaScript API" apenas.
# Não é necessário criar um Map ID — a /mapa usa OverlayView para os avatares
# customizados, que não depende de Advanced Markers (ver ADR 0015).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Somente para rodar os testes locais (integration/e2e) com Supabase local.
# Obtenha rodando `supabase start` e depois `supabase status`.
# NÃO são usados pelo app em runtime nem precisam ir para a Vercel.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
